{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "targetDefaults": {
    "generate": { "cache": true },
    "build": {
      "cache": true,
      "dependsOn": ["^build", "generate"],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/build",
        "{projectRoot}/out"
      ]
    },
    "lint": { "cache": true, "dependsOn": ["^build", "generate"] },
    "test": { "cache": true, "dependsOn": ["^build", "generate"] },
    "dev": { "continuous": true, "dependsOn": ["^build", "generate"] }
  }
}
